%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-
{erl_opts,
 [warn_unused_import, warn_export_vars, warnings_as_errors, verbose, report, debug_info]}.

{minimum_otp_vsn, "21"}.

{deps, []}.

{plugins, [{pc, {git, "https://github.com/OpenRiak/port_compiler", {branch, "openriak-3.6"}}}]}.

{port_specs,
 [{".*", "priv/zstd_external.so",  %% to distinguish from zstd.so that comes with otp-28
   ["c_src/zstd_external.c",
    "c_src/zstd/lib/{common,compress,decompress,dictBuilder,legacy,deprecated}/*.c",
    "c_src/zstd/lib/decompress/huf_decompress_amd64.S"
   ]}
 ]
}.

{port_env,
 [{"CFLAGS", "$CFLAGS -Wall -fPIC -O3 -std=c99"}
 ]
}.

{provider_hooks,
 [{pre,
   [{compile, {pc, compile}},
    {clean, {pc, clean}}
   ]
  }
 ]
}.

{dialyzer,
 [{warnings,
   [unknown, no_return, unmatched_returns, error_handling, missing_return, extra_return]},
  {plt_apps, top_level_deps},
  {plt_extra_apps, []},
  {plt_location, local},
  {base_plt_apps, [erts, stdlib, kernel]},
  {base_plt_location, global}]}.

{xref_checks,
 [undefined_function_calls,
  locals_not_used,
  deprecated_function_calls,
  deprecated_functions]}.

{alias, [{test, [format, lint, hank, xref, dialyzer, eunit, edoc]}]}.
